[Unit]
Description=Dafy chatbot and control panel
After=dafy-wechat.service
Wants=dafy-wechat.service

[Service]
Type=simple
WorkingDirectory=@ROOT@
EnvironmentFile=@DATA@/runtime.env
ExecStart=@ROOT@/.venv/bin/python @ROOT@/deploy/ubuntu/entrypoint.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@DATA@
TimeoutStopSec=15

[Install]
WantedBy=default.target
